{
  "name": "omp-llm-verifier",
  "version": "0.1.0",
  "description": "LLM-as-a-Verifier plugin for omp: fine-grained logprob-based reward scoring and Probabilistic Pivot Tournament best-of-N selection, using opencode-go/deepseek-v4-flash.",
  "type": "module",
  "license": "MIT",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "omp": {
    "extensions": ["./src/index.ts"]
  },
  "bin": {
    "llm-verifier": "./src/cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "verify": "bun run src/cli.ts"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=17.3.7"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "17.3.7",
    "@types/bun": "1.3.14"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
