{
  "name": "omp-llm-verifier",
  "version": "0.2.0",
  "description": "LLM-as-a-Verifier self-verification extension for oh-my-pi.",
  "type": "module",
  "license": "MIT",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "omp": {
    "extensions": ["./src/index.ts"],
    "settings": {
      "enabled": {
        "type": "boolean",
        "default": false,
        "description": "为普通 OMP 模型请求启用自动候选生成与 LLM-as-a-Verifier 选择"
      }
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": ">=17.3.7",
    "@oh-my-pi/pi-coding-agent": ">=17.3.7"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "17.3.7",
    "@oh-my-pi/pi-coding-agent": "17.3.7",
    "@types/bun": "1.3.14"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
